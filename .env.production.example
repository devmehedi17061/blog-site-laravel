# ─────────────────────────────────────────────────────────────────────────
# The live server's .env. Copy to .env on the server,
# fill in the blanks, then: php artisan key:generate (first time only),
# php artisan config:cache, php artisan security:check.
# Never commit the filled-in copy.
# ─────────────────────────────────────────────────────────────────────────
APP_NAME="My Site"
APP_ENV=production
APP_KEY=
# Never true on a live site: an error page would show code, paths and settings.
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# warning, not debug: debug writes every query (and what was in it) to disk.
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
# A user with rights on this one database only — never root.
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# The session cookie only ever travels over HTTPS, is out of JavaScript's
# reach and is not sent along with other sites' requests.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail is set up in the panel: Settings → Email.

# This site's own pack in sites/<name>/, if it has one (docs/updates-and-site-packs.md).
SITE_PACK=
# GitHub repository the updater reads (Settings → Updates).
CMS_UPDATE_REPO=devmehedi17061/blog-site-laravel
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# After going live, in the panel:
#  · Settings → Security → HTTPS & headers: Force HTTPS on, then HSTS on.
#  · Settings → Spam protection: Cloudflare Turnstile keys for this domain,
#    and "protect the sign-in page" on.
#  · Cron: * * * * * php /path/to/artisan schedule:run   (daily backups,
#    trash purge, the security check). Without cron the panel takes the
#    daily backup itself.
