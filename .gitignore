# ── Never in the core repository ──────────────────────────────────────────
# Each site's own pack (sites/<name>/) lives with that site; only the
# README explaining packs is part of the core.
/sites/*
!/sites/README.md
/public/site-build
/public/site-hot
# Release builds and the file list a release leaves on a site.
/build-release
/.cms-files
# Database dumps and archives lying in the project root (a dump holds
# password hashes and mail passwords).
/*.sql
/*.sql.gz
/*.zip
